# =============================================
# Flowise RAG Chatbot Configuration
# =============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# =============================================
# OpenAI Configuration
# =============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=YweYEyRXx8xj-sYBAvJSHHjkRx2bsZXrIwGkF0ICOF0

# =============================================
# Flowise Deployment Configuration
# =============================================
# Your Flowise instance URL (local or deployed)
# For local development: http://localhost:3000
# For Railway deployment: https://your-app-name.railway.app
FLOWISE_URL=http://localhost:3000

# Get your chatflow ID after deploying the workflow in Flowise
CHATFLOW_ID=your-chatflow-id-here

# =============================================
# Flowise Credentials (for admin access)
# =============================================
# These are used to log into Flowise UI
# Not needed for the chatbot API calls, but useful for administration
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=your-secure-password

# =============================================
# Frontend Configuration
# =============================================
# Toggle chatbot feature
CHATBOT_ENABLED=true

# Show source documents in responses
SHOW_SOURCE_DOCUMENTS=true

# =============================================
# Development Configuration
# =============================================
# Set to 'development' or 'production'
NODE_ENV=development
